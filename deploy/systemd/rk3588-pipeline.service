[Unit]
Description=RK3588 Production Pipeline
After=network.target rk3588-dashboard.service
Wants=rk3588-dashboard.service

[Service]
Type=simple
User=cat
Environment=HOME=/home/cat
Environment=PYTHONPATH=/home/cat/.local/lib/python3.10/site-packages
Environment=RTSP_URL=rtsp://192.168.1.168:554/stream
Environment=MODEL_PATH=/opt/rk3588-toolkit/models/yolov5s-640-640.rknn
Environment=DASHBOARD_URL=http://localhost:8080
WorkingDirectory=/opt/rk3588-toolkit
ExecStart=/usr/bin/python3 /opt/rk3588-toolkit/bin/prod_pipeline.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
