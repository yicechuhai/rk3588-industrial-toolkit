[Unit]
Description=RK3588 OPC UA Server (Standalone)
Documentation=https://github.com/yicechuhai/rk3588-industrial-toolkit
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/rk3588-toolkit
ExecStart=/opt/rk3588-toolkit/bin/opcua_server_demo \
    /opt/rk3588-toolkit/config/opcua_example.yaml
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rk3588-opcua

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/rk3588-toolkit /tmp

[Install]
WantedBy=multi-user.target
