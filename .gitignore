*.onnx
*.pt

# 测试输出
detection_result.jpg
test_output/
*.log

# 系统文件
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# 离线包
offline_pack/deps/
offline_pack/*.tar.gz
offline_pack/*.deb

# 编译产物
*.o
*.so
*.a
cmake-build-*/
